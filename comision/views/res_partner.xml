<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Sale order form view inherited-->
    <record id="view_res_partner_comision_form" model="ir.ui.view">
        <field name="name">rest.partner.view.form.inherit.comision</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//field[@name='category_id']" position="after">
                <field name="x_es_comisionista"/>
                <field name="x_comision" invisible="not x_es_comisionista"/>
            </xpath>
        </field>
    </record>
</odoo>
