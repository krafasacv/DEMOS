<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    AccountMove form view inherited-->
    <record id="view_order_comision_form" model="ir.ui.view">
        <field name="name">account.view_move_form.comision</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/header/field[@name='state'][2]" position="after">
                <button string="Pagar Comision" type="object" name="pagar_comision" invisible="x_status_comision == 'to_pay'"/>
            </xpath>
            <xpath expr="/form//div[@name='journal_div']" position="after">
                <field name="x_comisionista" force_save="1"/>
                <field name="x_comision" force_save="1" readonly="1"/>
                <field name="x_fecha_comision" invisible="x_status_comision != 'paid'" force_save="1" readonly="1"/>
            </xpath>
        </field>
    </record>
    <!--    AccountMove tree view inherited-->
    <record id="view_order_comision_tree" model="ir.ui.view">
        <field name="name">account.view_move_tree.comision</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/list//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="x_status_comision" optional="show" widget="badge" decoration-it="x_status_comision == 'no'" decoration-info="x_status_comision == 'comision'" decoration-primary="x_status_comision == 'to_pay'" decoration-success="x_status_comision == 'paid'"/>
            </xpath>
            <xpath expr="/list//button[@name='action_force_register_payment']" position="after">
                <button string="Pagar Comision" type="object" name="pagar_comision"/>
            </xpath>
        </field>
    </record>
</odoo>
